# One origin for both the client and the API (guidelines/06-backend-architecture.md,
# "Deployment & HTTPS") -- this is load-bearing, not just convenience: it's
# what keeps SameSite=Lax (the session cookie's primary CSRF defense) working
# at all. A cross-origin client/API split would force SameSite=None, which
# removes that protection entirely.
#
# Certs are generated by deploy/docker/setup-ssl-windows.sh, not committed
# (server/.gitignore). Caddy fails to start until that script has run at least
# once -- expected, not a bug: TLS termination is this file's one job it can't
# do without them.
https://localhost {
	tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem

	encode gzip

	# gorilla/websocket upgrades transparently through reverse_proxy -- Caddy
	# detects the Connection: Upgrade header itself, no separate WS directive.
	handle /v1/* {
		reverse_proxy app:8080
	}
	handle /healthcheck {
		reverse_proxy app:8080
	}
	handle {
		reverse_proxy client:5173
	}
}
